{
  "name": "@blokdots/components",
  "version": "3.4.0",
  "description": "blokdots Virtual Components to use in your projects.",
  "main": "dist/index.js",
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./webserver": "./dist/webserver",
    "./dist/webserver": "./dist/webserver",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prettier": "prettier --write 'src/**/*.{t,j}s'",
    "lint": "eslint 'src/**/*.{t,j}s'",
    "lint-fix": "eslint 'src/**/*.{t,j}s' --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blokdots/components.git"
  },
  "keywords": [
    "blokdots",
    "Arduino",
    "hardware prototyping"
  ],
  "author": "blokdots",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/blokdots/components/issues"
  },
  "homepage": "https://github.com/blokdots/components#readme",
  "devDependencies": {
    "@types/johnny-five": "^2.1.11",
    "@types/node-pixel": "^0.11.2",
    "@types/qr-image": "^3.2.9",
    "@types/ws": "^8.18.1",
    "johnny-five": "https://github.com/blokdots/johnny-five",
    "socket.io": "^4.8.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "firmata": "https://github.com/blokdots/firmata.js",
    "node-pixel": "https://github.com/blokdots/node-pixel",
    "oled-font-5x7": "^1.0.3",
    "oled-js": "https://github.com/blokdots/oled-js#blokdots",
    "qr-image": "^3.2.0"
  },
  "peerDependencies": {
    "johnny-five": "*",
    "socket.io": "^4.8.1",
    "ws": "^8.17.1"
  }
