{
  "name": "@blokdots/components",
  "version": "4.0.0",
  "description": "blokdots Virtual Components to use in your projects.",
  "main": "dist/index.cjs",
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.mjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./webserver": "./dist/webserver",
    "./dist/webserver": "./dist/webserver",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.browser.config.ts",
    "dev": "vite build --watch",
    "prettier": "prettier --write 'src/**/*.{t,j}s'",
    "lint": "eslint 'src/**/*.{t,j}s'",
    "lint-fix": "eslint 'src/**/*.{t,j}s' --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blokdots/components.git"
  },
  "keywords": [
    "blokdots",
    "Arduino",
    "hardware prototyping"
  ],
  "author": "blokdots",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/blokdots/components/issues"
  },
  "homepage": "https://github.com/blokdots/components#readme",
  "devDependencies": {
    "@types/qr-image": "^3.2.9",
    "@types/ws": "^8.18.1",
    "socket.io": "^4.8.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "qr-image": "^3.2.0"
  },
  "peerDependencies": {
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "ws": "^8.17.1"
  }
}
